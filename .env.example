# Optional Neon/PostgreSQL connection. Leave empty for the persistent local SQLite fallback.
DATABASE_URL=

# Optional Gemini access for multimodal OCR and LLM extraction fallbacks.
GEMINI_API_KEY=

# Optional Hugging Face Hub authentication for model downloads.
HF_TOKEN=

# Comma-separated browser origins accepted by the backend.
CORS_ORIGINS=http://localhost:5173

# CPU is the portable Docker default. Use cuda only with a compatible GPU runtime.
MODEL_DEVICE=cpu

# The Docker frontend reverse-proxies this path to the backend.
VITE_BACKEND_URL=/api

# Local Vite development proxy target. Docker uses Nginx instead.
VITE_PROXY_TARGET=http://localhost:8000
